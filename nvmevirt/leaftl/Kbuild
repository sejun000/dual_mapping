# Select one of the targets to build
#CONFIG_NVMEVIRT_NVM := y
CONFIG_NVMEVIRT_SSD := y
#CONFIG_NVMEVIRT_ZNS := y
#CONFIG_NVMEVIRT_KV := y

obj-m   := nvmev.o
nvmev-objs := main.o pci.o admin.o io.o dma.o
ccflags-y += -Wno-unused-variable -Wno-unused-function

ccflags-$(CONFIG_NVMEVIRT_NVM) += -DBASE_SSD=INTEL_OPTANE
nvmev-$(CONFIG_NVMEVIRT_NVM) += simple_ftl.o

ccflags-$(CONFIG_NVMEVIRT_SSD) += -DBASE_SSD=SAMSUNG_970PRO
# dual_mapping: pluggable FTL core (dm/ftl_$(DM_POLICY).c) behind dm_ftl.c; conv_ftl.c kept for reference only
DM_POLICY := leaftl
nvmev-$(CONFIG_NVMEVIRT_SSD) += ssd.o dm_ftl.o dm/dm_wbuf.o dm/ftl_$(DM_POLICY).o pqueue/pqueue.o channel_model.o
# leaftl: the learned-index PLR needs IEEE doubles bit-identical to ftlsim. SSE is enabled for this object only;
# ftl_leaftl.c itself compiles everything general-regs-only except its target("sse2,fma") FP routines, which run
# strictly between kernel_fpu_begin()/kernel_fpu_end(). CC_FLAGS_FPU does not exist on x86 before 6.10: fall back.
DM_FPU_FLAGS := $(if $(CC_FLAGS_FPU),$(CC_FLAGS_FPU),-mhard-float -msse -msse2)
DM_NOFPU_FLAGS := $(if $(CC_FLAGS_NO_FPU),$(CC_FLAGS_NO_FPU),-mno-sse -mno-sse2)
CFLAGS_dm/ftl_leaftl.o += $(DM_FPU_FLAGS)
CFLAGS_REMOVE_dm/ftl_leaftl.o += $(DM_NOFPU_FLAGS)

ccflags-$(CONFIG_NVMEVIRT_ZNS) += -DBASE_SSD=WD_ZN540
#ccflags-$(CONFIG_NVMEVIRT_ZNS) += -DBASE_SSD=ZNS_PROTOTYPE
ccflags-$(CONFIG_NVMEVIRT_ZNS) += -Wno-implicit-fallthrough
nvmev-$(CONFIG_NVMEVIRT_ZNS) += ssd.o zns_ftl.o zns_read_write.o zns_mgmt_send.o zns_mgmt_recv.o channel_model.o

ccflags-$(CONFIG_NVMEVIRT_KV) += -DBASE_SSD=KV_PROTOTYPE
nvmev-$(CONFIG_NVMEVIRT_KV) += kv_ftl.o append_only.o bitmap.o
