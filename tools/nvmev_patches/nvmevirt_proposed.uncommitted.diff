+					f->ct_lpn[tb * 4 + tk] = f->ct_lpn[sb * 4 + sk]; f->ct_ppn[tb * 4 + tk] = f->ct_ppn[sb * 4 + sk];
+					f->ct_lpn[sb * 4 + sk] = DM_NONE32; f->ct_ppn[sb * 4 + sk] = DM_NONE32; f->kick_moves++;
+					tb = sb; tk = sk; sk = f->kq_k[n]; n = f->kq_par[n];
