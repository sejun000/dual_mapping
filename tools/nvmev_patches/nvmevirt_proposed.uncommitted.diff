+{
+	f->kick_probe += probes;
+	/* (2026-11-12) one DRAM round (dram_ns) per dequeued bucket: the 4 alt-bucket probes of one bucket are independent
+	 * and overlap across DRAM banks, consecutive rounds depend on each other (lower bound on the search time) */
