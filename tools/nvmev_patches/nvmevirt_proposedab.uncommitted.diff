+/* ftlsim ct_kick: visited-set insert; 1 if b was not yet visited in this search */
+static int prop_kh_add(struct prop *f, u64 b)
+{
+	u32 h = (u32)prop_ct_mix(b) & f->kh_mask;
+	for (; f->kh_ep[h] == f->kep; h = (h + 1) & f->kh_mask) if (f->kh_key[h] == b) return 0;
+	f->kh_ep[h] = f->kep; f->kh_key[h] = b;
+	return 1;
+}
+/* ftlsim ct_kick: lpn's bucket pair is full. BFS (MemC3) from b1, b2: for each way k of a dequeued bucket B, the
+ * entry's other bucket alt; a free way in alt ends the search, else alt is enqueued (parent (B, k)) if unvisited and
+ * fewer than ct_kick buckets were visited. Visited buckets are distinct, so the path is executed from its end (each
+ * entry, lpn and ppn, into the slot freed after it), freeing one way of b1 / b2. 1 = room made. */
+static void prop_kick_rec(struct prop *f, u32 rd, u32 probes)
+{
+	f->kick_probe += probes;
+	/* (2026-11-12) one DRAM round (dram_ns) per dequeued bucket: the 4 alt-bucket probes of one bucket are independent
+	 * and overlap across DRAM banks, consecutive rounds depend on each other (lower bound on the search time) */
+	if (f->dram_ns && f->fo.dram) f->fo.dram(f->fo.ctx, (u64)(rd - probes) * f->dram_ns, f->dram_lock ? 1 : 0);
+	int b = 0;
+	while ((rd >> (b + 1)) && b < 15) b++;
+	f->kick_rd += rd; f->kick_rdh[b]++;
+}
+static int prop_ct_kick(struct prop *f, u64 lpn)
+{
+	u32 nq = 0, h, nvis = 2, rd = 0, pr = 0; int k;
+	if (!f->ct_kick) return 0;
+	f->kick_n++;
+	if (++f->kep == 0) { memset(f->kh_ep, 0, sizeof(u32) * (f->kh_mask + 1)); f->kep = 1; }
+	f->kq_b[nq] = prop_ct_b1(f, lpn); f->kq_par[nq] = -1; f->kq_k[nq] = 0; prop_kh_add(f, f->kq_b[nq]); nq++;
+	f->kq_b[nq] = prop_ct_b2(f, lpn); f->kq_par[nq] = -1; f->kq_k[nq] = 0; prop_kh_add(f, f->kq_b[nq]); nq++;
+	for (h = 0; h < nq; h++) {
+		u64 B = f->kq_b[h];
+		rd++;   /* read bucket B */
+		for (k = 0; k < 4; k++) {
+			u32 e = f->ct_lpn[B * 4 + k]; u64 alt; int fr;
+			if (e == DM_NONE32) continue;
+			alt = prop_ct_b1(f, e) == B ? prop_ct_b2(f, e) : prop_ct_b1(f, e);
+			fr = prop_ct_free_in(f, alt);
+			rd++; pr++;   /* read bucket alt (B itself was read when it was probed / by the room check) */
+			if (fr >= 0) {   /* move (B, k) -> (alt, fr), then each parent's entry into the slot just vacated */
+				u64 tb = alt; int tk = fr, sk = k; s32 n = (s32)h;
+				while (n >= 0) {
+					u64 sb = f->kq_b[n];
+					f->ct_lpn[tb * 4 + tk] = f->ct_lpn[sb * 4 + sk]; f->ct_ppn[tb * 4 + tk] = f->ct_ppn[sb * 4 + sk];
+					f->ct_lpn[sb * 4 + sk] = DM_NONE32; f->ct_ppn[sb * 4 + sk] = DM_NONE32; f->kick_moves++;
+					tb = sb; tk = sk; sk = f->kq_k[n]; n = f->kq_par[n];
+				}
+				f->kick_ok++; prop_kick_rec(f, rd, pr); return 1;
+			}
+			if (nvis < f->ct_kick && prop_kh_add(f, alt)) { nvis++; f->kq_b[nq] = alt; f->kq_par[nq] = (s32)h; f->kq_k[nq] = (u8)k; nq++; }
+		}
+	}
+	f->kick_fail++; prop_kick_rec(f, rd, pr); return 0;
+}
