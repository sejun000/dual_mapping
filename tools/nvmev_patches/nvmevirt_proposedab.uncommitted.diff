+/* (2026-11-11) DRAM time on the host path: the work ends before the next flash op of this request can start */
+static void dm_cb_dram(void *ctx, u64 ns, int mode)
+{
+	struct dm_ns *d = ctx;
+	if (!d->in_host) return;
+	if (mode == 2) return;   /* table-lock waits: not modeled (per-bucket locks block only the 2-3 moved buckets) */
+	dm_read_flush(d);
+	if (mode == 1) {   /* the search runs on the earliest-free FTL core */
+		int i, c = 0;
+		for (i = 1; i < 4; i++) if (d->fcore[i] < d->fcore[c]) c = i;
+		if (d->fcore[c] > d->stime) d->stime = d->fcore[c];
+		d->fcore[c] = d->stime + ns; d->fcore_on = 1;
+	}
+	d->stime += ns;
+	if (d->stime > d->latest) d->latest = d->stime;
+}
